# Local helper file only. Do not commit secrets.
VM_HOST=127.0.0.1
VM_PORT=22
VM_USER=root
# Keep key out of git. Store private key in a separate secure file.
VM_SSH_KEY_FILE=~/.ssh/vm_prod_id_rsa

# Optional observability settings for vm-prod
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=change_me_grafana_admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
